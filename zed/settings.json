// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "git": {
        "inline_blame": {
            "enabled": true
        },
        "enable_status": false,
        "path_style": "file_name_first",
        "hunk_style": "staged_hollow",
        "enable_diff": false,
        "git_gutter": "hide"
    },
    "gutter": {
        "folds": false,
        "line_numbers": true,
        "runnables": false
    },
    "scrollbar": {
        "git_diff": false
    },
    "collaboration_panel": {
        "button": false
    },
    "project_panel": {
        "dock": "left"
    },
    "git_panel": {
        "sort_by_path": true,
        "tree_view": true
    },
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "buffer_font_family": "Fira Code",
    "helix_mode": false,
    "agent": {
        "profiles": {},
        "favorite_models": [],
        "inline_assistant_model": {
            "provider": "anthropic",
            "model": "claude-sonnet-4-6-latest",
            "enable_thinking": false
        },
        "model_parameters": []
    },
    "file_finder": {
        "include_ignored": "smart"
    },
    // "buffer_font_family": "Fira Code",
    "ssh_connections": [
        {
            "host": "hazel.local",
            "username": "alana",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/mnt/tank/docker"
                    ]
                },
                {
                    "paths": [
                        "/mnt/tank/opt"
                    ]
                }
            ]
        },
        {
            "host": "hazel.zuul-hoki.ts.net",
            "username": "alana",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/mnt/tank/docker"
                    ]
                }
            ]
        }
    ],
    "buffer_line_height": "comfortable",
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "edit_predictions": {
        "provider": "zed",
        "mode": "eager"
    },
    "disable_ai": false,
    "autosave": "on_focus_change",
    "vim_mode": true,
    "icon_theme": "Zed (Default)",
    "base_keymap": "VSCode",
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Catppuccin Mocha"
    },
    "languages": {
        "YAML": {
            "tab_size": 2,
            "hard_tabs": false,
            "format_on_save": "off"
        },
        "JSON": {
            "tab_size": 2,
            "hard_tabs": false,
            "format_on_save": "off"
        },
        "Python": {
            "code_actions_on_format": {
                "source.organizeImports.ruff": true
            },
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            },
            "tab_size": 4,
            "hard_tabs": false,
            "format_on_save": "on",
            "show_edit_predictions": true,
            "language_servers": [
                "!pyrefly",
                "!pyright",
                "!pylsp",
                "ty",
                "basedpyright",
                "ruff",
                "codebook"
            ]
        }
    },
    "lsp": {
        "basedpyright": {
            "settings": {
                "basedpyright": {
                    "disableOrganizeImports": true // let ruff handle this
                },
                "python": {
                    "pythonPath": "venv/bin/python",
                    "analysis": {
                        "autoImportCompletions": true,
                        "autoSearchPaths": true,
                        "diagnosticMode": "off",
                        "typeCheckingMode": "off"
                    }
                }
            }
        }
    },
    "file_scan_exclusions": ["__pycache__", ".DS_Store"],
    "theme_overrides": {
        "Catppuccin Mocha": {
            "border": "#3e4452",
            "border.variant": "#3e4452",
            "border.focused": "#3e4452",
            "border.selected": "#3e4452",
            "border.transparent": "#3e4452",
            "border.disabled": "#3e4452"
        },
        "Catppuccin Macchiato": {
            "border": "#3e4452",
            "border.variant": "#3e4452",
            "border.focused": "#3e4452",
            "border.selected": "#3e4452",
            "border.transparent": "#3e4452",
            "border.disabled": "#3e4452"
        },
        "Catppuccin Frappé": {
            "border": "#3e4452",
            "border.variant": "#3e4452",
            "border.focused": "#3e4452",
            "border.selected": "#3e4452",
            "border.transparent": "#3e4452",
            "border.disabled": "#3e4452"
        },
        "Catppuccin Latte": {
            "border": "#3e4452",
            "border.variant": "#3e4452",
            "border.focused": "#3e4452",
            "border.selected": "#3e4452",
            "border.transparent": "#3e4452",
            "border.disabled": "#3e4452"
        }
    }
}
